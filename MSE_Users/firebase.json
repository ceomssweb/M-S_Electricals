{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "rasi-electricals",
          "appId": "1:114554009961:android:3cc7daffd92e35c1c0a5f8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mselectricals-4cc75",
          "configurations": {
            "web": "1:337897639107:web:25d7f5a4e291b9928c2676"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "mselectricals",
    "location": "asia-south2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "M&S Electicals",
        "supportEmail": "manojrasi21@gmail.com"
      }
    }
  }
}
